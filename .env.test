# Database (test - use a separate database from production!)
DATABASE_URL=postgresql://test_user:test_password@localhost:5432/school_erp_test

# Auth
JWT_SECRET=test-jwt-secret-do-not-use-in-production
JWT_EXPIRES=1h

# Server
PORT=0
NODE_ENV=test

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Rate Limiting (disabled for tests)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
